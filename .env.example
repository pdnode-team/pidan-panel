# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_NAME=pidan-panel
APP_URL=http://${HOST}:${PORT}

# Database
# DB_DATABASE=tmp/db.sqlite3

# Instance data root (servers/, backups/, db). When running the panel itself
# inside Docker, set this to a path that exists IDENTICALLY on the docker host
# and mount it into the panel at the same absolute path, e.g.:
#   docker run -v /srv/pidan-panel/data:/srv/pidan-panel/data \
#              -e PIDAN_DATA_DIR=/srv/pidan-panel/data ...
# PIDAN_DATA_DIR=/srv/pidan-panel/data

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
LIMITER_STORE=database

# Health checks
# DISK_WARN_PERCENT=75